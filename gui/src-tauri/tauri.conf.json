{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RustDesk Tunnel",
  "version": "0.1.0",
  "identifier": "dev.vipa.rdt",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RustDesk Tunnel",
        "width": 820,
        "height": 680,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": ["icons/icon.png"]
  }
}
